# ===========================================================================
# Root .env for the docker-compose stack. Copy to .env and fill in real values.
#   cp .env.example .env
# The api container FAILS TO START in production if SECRET_KEY is empty
# (intentional, fail-closed). Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# ===========================================================================

# REQUIRED — random 64-char hex string; rotating it invalidates all sessions.
SECRET_KEY=

# REQUIRED in production — your Telegram bot token from @BotFather.
BOT_TOKEN=

# Postgres password (used by both the postgres and api services).
DB_PASSWORD=change_me

# "production" (default) or "development". Leave as production for real deploys.
ENVIRONMENT=production

# Public URL of the Mini App / frontend (used for CORS + bot deep links).
WEBAPP_URL=https://your-domain.com
# Comma-separated CORS origins. If empty, falls back to WEBAPP_URL.
ALLOWED_ORIGINS=https://your-domain.com

# Trusted reverse proxies in front of the app, counted from the right of
# X-Forwarded-For. Drives the rate-limit key + audit-log client IP. MUST match
# your topology or it's either spoofable (too low) or wrong (too high):
#   1 = single nginx in front of the app   (docker-compose default)
#   2 = Cloudflare -> nginx -> app
TRUSTED_PROXY_COUNT=1

# DB connection pool sizing (optional).
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# NowPayments (crypto deposits / payouts).
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_PUBLIC=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_IPN_URL=https://your-domain.com/api/payments/nowpayments/webhook

# Background loops run in the dedicated `worker` service (compose); web workers
# set this false. A Redis leader lock keeps them single-run regardless.
RUN_BACKGROUND_TASKS=true

# Dev-only toggles — MUST stay false in production.
ALLOW_AUTO_CREATE_TABLES=false
ALLOW_DEV_LOGIN=false

# Bot display name (bot service).
APP_NAME=Forum
