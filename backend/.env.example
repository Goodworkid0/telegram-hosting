# PostgreSQL (required — this app supports PostgreSQL only):
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/hosting
SECRET_KEY=your-super-secret-key-change-in-production
BOT_TOKEN=your-telegram-bot-token
WEBAPP_URL=https://your-domain.com
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Rate limiting / proxy awareness.
# TRUSTED_PROXY_COUNT: number of trusted reverse proxies in front of the app.
#   0 (default) = ignore X-Forwarded-For, key limits on the socket peer.
#   1 = single nginx (the provided nginx.conf appends the resolved client IP).
#   2 = Cloudflare -> nginx if you key off the client behind both.
# Set this correctly in production, otherwise rate limits are either keyed on the
# proxy IP (one shared bucket) or spoofable via a forged X-Forwarded-For header.
TRUSTED_PROXY_COUNT=1
# Default per-IP cap for endpoints without an explicit limit.
DEFAULT_RATE_LIMIT=300/minute
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ALLOW_AUTO_CREATE_TABLES=false
# Set true only for local/dev bootstrap without migrations.
# In production prefer Alembic migrations.
ALLOW_DEV_LOGIN=false
# Set true only for local/dev to enable /api/auth/dev-login endpoint.
NOWPAYMENTS_API_KEY=your-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=your-nowpayments-ipn-secret
NOWPAYMENTS_IPN_URL=https://your-domain.com/api/payments/nowpayments/webhook

# NowPayments Payout (auto-withdrawal)
NOWPAYMENTS_PAYOUT_EMAIL=your-nowpayments-account-email
NOWPAYMENTS_PAYOUT_PASSWORD=your-nowpayments-account-password
NOWPAYMENTS_PAYOUT_IPN_URL=https://your-domain.com/api/payments/nowpayments/payout-webhook
